# Copy this file to .env.local and fill in your real values.
# Required for the contact form (app/api/contact/route.ts) to send email via nodemailer.

# SMTP server details. Examples:
# - Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=an App Password
#   (not your normal password — generate one at https://myaccount.google.com/apppasswords,
#   requires 2-Step Verification to be enabled on the account)
# - Resend, SendGrid, Mailgun, etc: use the SMTP credentials from their dashboard
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact form submissions get delivered. Defaults to data/profile.ts's
# email if not set.
CONTACT_TO_EMAIL=
